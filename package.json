{
  "name": "blinko-monorepo",
  "version": "1.8.8",
  "private": true,
  "packageManager": "bun@1.2.8",
  "workspaces": [
    "app",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "cd app && bun run tauri dev",
    "build:web": "turbo run build:web",
    "test": "bun test scripts/tests/ server/__tests__ shared/lib/__tests__ app/src",
    "start:server:production": "ncp dist/public server/public && cd server && bun run start",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:backend": "turbo run dev --filter=@blinko/backend",
    "dev:frontend": "turbo run dev --filter=@blinko/frontend",
    "postinstall": "turbo run prisma:generate --filter=@blinko/backend",
    "setup": "bun install",
    "prisma:generate": "cd prisma && prisma generate",
    "prisma:migrate:dev": "cd prisma && prisma migrate dev",
    "prisma:migrate:deploy": "cd prisma && prisma migrate deploy",
    "prisma:studio": "cd prisma && prisma studio",
    "build:seed": "tsup prisma/seed.ts --outDir dist",
    "seed": "bun dist/seed.js",
    "build:blinko:types": "tsc -p tsconfig.blinko.json"
  },
  "devDependencies": {
    "prisma": "5.22.0",
    "turbo": "latest",
    "typescript": "^5.1.6",
    "vite-plugin-pwa": "^1.0.0",
    "workbox-window": "^7.3.0"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "ncp": "^2.0.0"
  }
}
