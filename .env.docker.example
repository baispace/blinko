# ===========================================
# Docker Compose 环境配置模板
# ===========================================
# 使用方法：
#   1. 复制本文件:  cp .env.docker.example .env
#   2. 修改密码、域名等生产级配置
#   3. 启动:  docker compose -f docker-compose.prod.yml up -d
#
# 适用于: docker-compose.yml / docker-compose.prod.yml 编排的容器化部署

NODE_ENV=production

# Docker 网络内 PostgreSQL（host=postgres 是 compose service name）
# 端口 5435 映射到宿主机的 5432（参考 docker-compose.yml 中 services.postgres 的端口映射）
DATABASE_URL=postgresql://postgres:mysecretpassword@postgres:5435/postgres

# 公网/反代域名（部署时改成你的真实域名）
NEXTAUTH_URL=https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# 必须替换为强随机值，可用 openssl rand -base64 32 生成
NEXTAUTH_SECRET=CHANGE_ME_TO_RANDOM_SECRET
