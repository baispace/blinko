# ===========================================
# 本地开发环境配置模板（Local Development）
# ===========================================
# 使用方法：
#   1. 复制本文件:  cp .env.local.example .env
#   2. 视本机情况调整 DATABASE_URL 中的用户名
#   3. .env 已在 .gitignore 中，不会被提交
#
# 适用于: macOS/Linux 本机直接运行，无 Docker

NODE_ENV=development

# 本机 PostgreSQL（用 brew install postgresql@16 装的）
# 端口 5432，密码留空走系统信任认证，用户名为当前 mac 用户
DATABASE_URL=postgresql://baihe@localhost:5432/blinko

# 本地访问地址（与 .tmpl 保持一致）
NEXTAUTH_URL=http://localhost:1111
NEXT_PUBLIC_BASE_URL=http://localhost:1111
